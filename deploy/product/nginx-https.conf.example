# Copy to /etc/nginx/sites-available/auctionradar-https.conf and replace the
# example hostname and certificate paths before enabling this site.
server {
    listen 443 ssl;
    http2 on;
    server_name radar.example.invalid;

    ssl_certificate /etc/auctionradar/tls/fullchain.pem;
    ssl_certificate_key /etc/auctionradar/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 1m;
    server_tokens off;
    access_log off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    # The app sets no-referrer on capability links; do not override it here.

    location ~ ^/(share|api/public)/ {
        # Upstream errors otherwise include the entire secret-bearing URL.
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
