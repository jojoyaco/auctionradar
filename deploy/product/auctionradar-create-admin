#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
    printf 'Run this helper as root inside the LXC.\n' >&2
    exit 2
fi
if [[ "$#" -ne 1 || -z "$1" ]]; then
    printf 'Usage: auctionradar-create-admin USERNAME\n' >&2
    printf 'The password is read from stdin by auctionradar.web.manage; no default is used.\n' >&2
    exit 2
fi

exec runuser --user auctionradar -- env \
    AUCTIONRADAR_ENV=production \
    AUCTIONRADAR_WORKSPACE_MODE=private \
    AUCTIONRADAR_REGISTRATION_ENABLED=false \
    AUCTIONRADAR_SESSION_SECURE=true \
    PYTHONPATH=/opt/auctionradar/app \
    AUCTIONRADAR_DATA_DIR=/var/lib/auctionradar \
    AUCTIONRADAR_SECRET_FILE=/etc/auctionradar/session.key \
    AUCTIONRADAR_CREDENTIALS_KEY_FILE=/etc/auctionradar/credential.key \
    /opt/auctionradar/venv/bin/python -m auctionradar.web.manage create-user \
    --username "$1" --admin --password-stdin
