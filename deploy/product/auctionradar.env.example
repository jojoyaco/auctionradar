# Managed by the product installer. Keep this file root-owned and readable
# only by root and the auctionradar service group. Do not put passwords here.
AUCTIONRADAR_ENV=production
AUCTIONRADAR_WORKSPACE_MODE=private
AUCTIONRADAR_REGISTRATION_ENABLED=false
AUCTIONRADAR_DATA_DIR=/var/lib/auctionradar
AUCTIONRADAR_SECRET_FILE=/etc/auctionradar/session.key
AUCTIONRADAR_CREDENTIALS_KEY_FILE=/etc/auctionradar/credential.key
AUCTIONRADAR_SESSION_SECURE=true
AUCTIONRADAR_SESSION_HTTPONLY=true
AUCTIONRADAR_SESSION_SAMESITE=Lax
AUCTIONRADAR_TRUSTED_HOSTS=localhost,127.0.0.1
AUCTIONRADAR_TRUST_LOCAL_PROXY=true

# Optional and intentionally unset: only set after an explicit adoption plan.
# AUCTIONRADAR_LEGACY_OWNER_USERNAME=existing-owner
